---
const {
  code = '',
  light = false,
  install = false,
  hero = false,
  loopCodes,
} = Astro.props;
function highlight(s: string) {
  return s
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replace(
      /("[^"\n]*"|'[^'\n]*'|#[^\n]*|\b(?:import|from|as|def|return|False|True)\b|\b\d+\b)/g,
      (t) =>
        `<span class="${t.startsWith('#') ? 'comment' : t.startsWith('"') || t.startsWith("'") ? 'string' : /^\d/.test(t) ? 'number' : 'keyword'}">${t}</span>`,
    );
}
---

<div
  class:list={['terminal', { light, install, hero }]}
  data-loop-codes={loopCodes ? JSON.stringify(loopCodes) : undefined}
>
  <div class="window-bar">
    <i></i>
    <i></i>
    <i></i>
  </div>
  <pre><code set:html={highlight(code)}/></pre>
</div>
