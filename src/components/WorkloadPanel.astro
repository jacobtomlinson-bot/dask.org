---
import { asset } from '../data/site';
import Terminal from './Terminal.astro';
const { item, benchmark = false } = Astro.props;
---

<div class="workload-panel">
  <div class="workload-copy">
    <h2 class="medium-title">{item.title}</h2>
    <p>{item.text}</p>
    <div class="workload-actions">
      <a class="button" href={item.href}>
        Documentation
      </a>
      {benchmark ? (
        <a
          class="text-link"
          href="https://docs.coiled.io/blog/tpch.html?utm_source=dask.org&utm_medium=homepage"
        >
          Performance Benchmarks
        </a>
      ) : (
        item.video && (
          <a class="text-link" href={item.video}>
            {item.videoLabel}
          </a>
        )
      )}
    </div>
    <div class="workload-logos">
      {item.logos.map((name) => (
        <img
          src={asset(name)}
          alt={name.replaceAll('_', ' ').replace(/\.svg$/, '')}
        />
      ))}
    </div>
  </div>
  <Terminal code={item.code} />
</div>
