---
import Site from '../layouts/Site.astro';
import Hero from '../components/Hero.astro';
---

<Site title="Dask | Page not available">
  <Hero title="Page not available" />
  <section class="unavailable light-grid">
    <h2>This page is not part of the core-site rebuild.</h2>
    <p>
      Blog and event destinations have not been selected yet. No redirect has
      been guessed.
    </p>
    <p>
      <a class="text-link" href="/">
        Return to Dask home
      </a>{' '}
      or{' '}
      <a class="text-link" href="/get-started">
        get started with Dask
      </a>
      .
    </p>
  </section>
</Site>
<style>
  .unavailable {
    padding: 100px 8vw;
    min-height: 400px;
  }
  .unavailable h2 {
    font-size: 32px;
    line-height: 40px;
    margin-bottom: 24px;
  }
</style>
