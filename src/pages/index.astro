---
import Site from '../layouts/Site.astro';
import Terminal from '../components/Terminal.astro';
import WorkloadPanel from '../components/WorkloadPanel.astro';
import { asset, docs } from '../data/site';
import { workloads, deployments } from '../data/home';
import quotes from '../data/quotes.json';
import cases from '../data/cases.json';
---

<Site>
  <section class="home-intro dark-grid">
    <div class="home-hero">
      <div class="home-headline">
        <h1 class="boxed">Parallel Python</h1>
        <h2 class="boxed">Fast and Easy</h2>
        <p>Easy Parallel Python that does what you need</p>
        <a class="button" href="/get-started">
          Get started
        </a>
      </div>
      <div class="dashboard-art" aria-hidden="true">
        <div class="dashboard-window back">
          <div class="dash-toolbar">TASK STREAM</div>
          <div class="dash-empty"></div>
        </div>
        <div class="dashboard-window main">
          <div class="dash-toolbar">DASK DASHBOARD</div>
          <Terminal
            code={
              '# Arrays implement the NumPy API\nimport dask.array as da\nx = da.random.random((1000, 1000),\n                      chunks=(100, 100))'
            }
          />
          <div class="dash-toolbar">PROGRESS STREAM　⌄</div>
          <div class="dash-empty"></div>
        </div>
        <div class="dashboard-window side">
          <div class="dash-toolbar">WORKERS</div>
          <div class="dash-empty"></div>
        </div>
      </div>
    </div>
    <div class="workload-tabs" data-tabs>
      <h2 class="section-title">What you can do with Dask</h2>
      <div
        class="tablist"
        role="tablist"
        aria-label="What you can do with Dask"
      >
        {workloads.map((w, i) => (
          <button
            id={`workload-tab-${i}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`workload-${i}`}
            tabindex={i === 0 ? 0 : -1}
          >
            {w.title}
          </button>
        ))}
      </div>
      {workloads.map((w, i) => (
        <div
          id={`workload-${i}`}
          role="tabpanel"
          aria-labelledby={`workload-tab-${i}`}
          hidden={i !== 0}
        >
          <WorkloadPanel item={w} benchmark={i === 0} />
        </div>
      ))}
    </div>
  </section>
  <section class="performance light-grid">
    <h2 class="section-title">Performance at Scale</h2>
    <div class="performance-row">
      <div class="performance-copy">
        <h3>Fast on Machines</h3>
        <p>
          Dask is lightweight, and runs your raw code on your machines without
          getting in the way. No virtualization or compilers.
        </p>
        <p>
          As the Python stack matures your code matures. Today Dask is 50%
          faster than Spark on standard benchmarks.
        </p>
      </div>
      <div
        class="benchmark-art"
        aria-label="Dask and Spark benchmark comparison"
      >
        <div class="benchmark-ring">
          <div>
            <strong>3497</strong>
            <small>seconds</small>
            <b>DASK</b>
          </div>
        </div>
        <div class="benchmark-ring spark">
          <div>
            <strong>4721</strong>
            <small>seconds</small>
            <b>SPARK</b>
          </div>
        </div>
      </div>
    </div>
    <div class="performance-row humans">
      <div class="human-code">
        <Terminal
          light
          code={
            'import pandas as pd\n\ndf = pd.read_parquet("s3://mybucket/myfile.parquet/")\n\ndf = df[df.value >= 0]\ndf.groupby("account")["value"].sum()'
          }
          loopCodes={[
            'import pandas as pd\n\ndf = pd.read_parquet("s3://mybucket/myfile.parquet/")\n\ndf = df[df.value >= 0]\ndf.groupby("account")["value"].sum()',
            'import dask.dataframe as dd\n\ndf = dd.read_parquet("s3://mybucket/myfile.*.parquet/")\n\ndf = df[df.value >= 0]\ndf.groupby("account")["value"].sum().compute()',
          ]}
        />
      </div>
      <div class="performance-copy">
        <h3>Made for Humans</h3>
        <p>Computers are cheap. Humans are expensive.</p>
        <p>Fortunately, humans already know how to use Dask.</p>
        <p>It’s just Python. It’s just pandas. It’s just NumPy.</p>
        <p>
          Dask’s dashboard guides you towards efficiency, quickly teaching you
          to become a distributed computing expert.
        </p>
      </div>
    </div>
    <div class="cheap">
      <h3>Cheap and Efficient</h3>
      <p>Fast humans + Fast machines = Cheap Computing</p>
      <div class="cost-demo">
        <label>
          Rows of Data Computed<output id="rows-value">0</output>
          <input
            id="rows"
            type="range"
            min="0"
            max="1000000000000"
            step="1000000000"
            value="0"
            aria-label="Rows of data computed"
          />
        </label>
        <div class="cost-total">
          Cost<output id="cost-value">$　0.03</output>
        </div>
      </div>
      <p>Dask users often process cloud data at $0.10 per TiB</p>
    </div>
  </section>
  <section class="deployment dark-grid">
    <h2 class="boxed">Where you can run Dask</h2>
    <div data-tabs>
      <div class="tablist" role="tablist" aria-label="Where to run Dask">
        {deployments.map((d, i) => (
          <button
            id={`deploy-tab-${i}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`deploy-${i}`}
            tabindex={i === 0 ? 0 : -1}
          >
            {d.title}
          </button>
        ))}
      </div>
      {deployments.map((d, i) => (
        <div
          id={`deploy-${i}`}
          role="tabpanel"
          aria-labelledby={`deploy-tab-${i}`}
          hidden={i !== 0}
        >
          <WorkloadPanel item={d} />
        </div>
      ))}
    </div>
  </section>
  <section class="testimonials">
    <div class="quote-intro">
      <h2>What users say about Dask</h2>
      <p>
        People use Dask and like it!
        <br />
        You won’t be alone!
      </p>
      <small>It’s easy　—　It’s massive　—　It solved my problem</small>
    </div>
    <div class="quote-columns">
      {[quotes.slice(0, 4), quotes.slice(4)].map((col) => (
        <div>
          {col.map((q) => (
            <figure class="quote">
              {q.logo && <img class="quote-logo" src={asset(q.logo)} alt="" />}
              <blockquote>{q.text}</blockquote>
              <figcaption>
                {q.portrait && <img src={asset(q.portrait)} alt="" />}
                {q.author}
              </figcaption>
            </figure>
          ))}
        </div>
      ))}
    </div>
  </section>
  <section class="org-band light-grid">
    <h2 class="medium-title">Organizations That Use Dask</h2>
    <div class="home-org-grid">
      {[
        'arm-logo.svg',
        'capital-one.png',
        'deshaw-co.png',
        'grubhub.png',
        'microsoft.png',
        'nasa.png',
        'nvidia.png',
        'shell.png',
        'two-sigma-logo.svg',
        'us-air-force.png',
        'defense-department.webp',
        'walmart.png',
      ].map((name) => (
        <img
          src={asset(name)}
          alt={name.replace(/\.(svg|png|webp)$/, '').replaceAll('-', ' ')}
        />
      ))}
    </div>
  </section>
  <section class="use-cases light-grid">
    <h2 class="boxed">Use Cases</h2>
    <p>Anything you can do with Python, you can scale with Dask</p>
    <div class="cases-grid">
      {cases.map((c) => (
        <a class="case" href={c.href}>
          <div class="case-art">
            <img src={asset(c.image)} alt="" />
          </div>
          <h3>{c.title}</h3>
          <small>Tools</small>
          <div class="tags">
            {c.tools.map((t) => (
              <span>{t}</span>
            ))}
          </div>
          <small>Data</small>
          <p>{c.data}</p>
        </a>
      ))}
      <div class="more-cases">
        <h3>Want more examples?</h3>
        <p>Visit the Dask Blog or Dask Youtube Channel</p>
        <div>
          <a
            class="button"
            href="https://www.youtube.com/playlist?list=PLJ0vO2F_f6OD0cwscL_yeG1aC3ESBquAT"
          >
            Dask Demo Day
          </a>
          <a class="text-link" href="https://www.youtube.com/c/dask-dev">
            Dask YouTube Channel
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="home-install light-grid">
    <div>
      <h2>Super easy to get started</h2>
      <p>
        You can run Dask right now on your computer. It’s simple and
        lightweight.
      </p>
      <a class="button" href={docs + 'install.html'}>
        Install Now
      </a>
    </div>
    <Terminal
      light
      code="$ conda install dask"
      install
      loopCodes={['$ conda install dask', '$ pip install "dask[complete]"']}
    />
  </section>
  <section class="laptop-note">
    <img
      class="closing-art"
      src={asset('illustration-home-stay-connected.svg')}
      alt=""
    />
    <p>
      Most people use Dask just on their laptops to scale out to 100 GiB
      datasets. Dask works great on a single machine.
    </p>
    <a class="text-link" href={docs}>
      Proceed to documentation
    </a>
  </section>
</Site>
<script>
  const rows = document.querySelector<HTMLInputElement>('#rows')!;
  rows.addEventListener('input', () => {
    document.querySelector('#rows-value')!.textContent = Number(
      rows.value,
    ).toLocaleString();
    document.querySelector('#cost-value')!.textContent =
      '$　' + (0.03 + (Number(rows.value) / 1e12) * 0.1).toFixed(2);
  });
</script>
<style is:global>
  .home-intro {
    padding: 80px var(--gutter);
    min-height: 1290px;
    overflow: hidden;
  }
  .home-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    height: 395px;
  }
  .home-headline {
    padding: 12px 28px;
  }
  .home-headline .boxed {
    font-size: 46px;
    line-height: 56px;
    margin-left: -28px;
    margin-bottom: 8px;
    padding-bottom: 15px;
  }
  .home-headline p {
    font-size: 18px;
    font-weight: 600;
    margin: 20px 0 24px;
  }
  .dashboard-art {
    height: 323px;
    position: relative;
    margin-left: 0;
  }
  .dashboard-window {
    background: #f6f6f6;
    border: 1px solid #999;
    position: absolute;
    color: #444;
    box-shadow: 0 2px 10px #0003;
  }
  .dashboard-window.main {
    left: 0;
    top: 28px;
    width: 65%;
    height: 294px;
    background: #262326;
  }
  .dashboard-window.back {
    left: 40%;
    width: 52%;
    top: 0;
    height: 240px;
  }
  .dashboard-window.side {
    right: -10%;
    width: 47%;
    top: 60px;
    height: 262px;
  }
  .dash-toolbar {
    font:
      11px/24px Inconsolata,
      monospace;
    background: #ebeaee;
    height: 24px;
    padding-left: 12px;
    letter-spacing: 2px;
  }
  .dashboard-window .terminal {
    border: 0;
  }
  .dashboard-window .window-bar {
    height: 20px;
  }
  .dashboard-window .terminal pre {
    font-size: 11px;
    line-height: 17px;
    min-height: 110px;
    padding: 16px;
  }
  .dash-empty {
    height: 100%;
    background: #f6f6f6;
  }
  .workload-tabs {
    max-width: 1116px;
    margin: 16px auto 0;
  }
  .workload-tabs h2 {
    margin-bottom: 16px;
  }
  .workload-tabs .tablist {
    margin-bottom: 24px;
  }
  .workload-panel {
    display: grid;
    grid-template-columns: 57% 43%;
    gap: 0;
    min-height: 450px;
  }
  .workload-copy {
    padding: 40px 76px 24px 24px;
    display: flex;
    flex-direction: column;
  }
  .workload-copy p {
    margin: 16px 0 24px;
  }
  .workload-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .workload-actions .text-link {
    font-size: 16px;
  }
  .workload-logos {
    display: flex;
    gap: 32px;
    align-items: center;
    margin-top: auto;
    padding-top: 80px;
  }
  .workload-logos img {
    height: 32px;
    width: auto;
    max-width: 33%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
  }
  .workload-panel > .terminal {
    margin: 24px 20px 24px 0;
    width: calc(100% - 20px);
    min-height: 425px;
  }
  .performance {
    padding: 80px var(--gutter) 120px;
    min-height: 1513px;
  }
  .performance > h2 {
    margin-bottom: 16px;
  }
  .performance-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: center;
    min-height: 450px;
  }
  .performance-copy {
    padding: 60px 50px;
  }
  .performance-copy h3 {
    margin-bottom: 16px;
  }
  .performance-copy p {
    margin-bottom: 12px;
  }
  .benchmark-art {
    background: #f5f7f5;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    padding: 32px;
    min-height: 349px;
  }
  .benchmark-ring {
    width: 235px;
    height: 235px;
    border-radius: 50%;
    background: conic-gradient(#61ba92 0 69%, #33363d 69% 100%);
    padding: 30px;
    transform: rotate(0deg);
    position: relative;
  }
  .benchmark-ring > div {
    background: #f6f6f6;
    border: 22px solid #33363d;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }
  .benchmark-ring strong {
    font-size: 16px;
  }
  .benchmark-ring small {
    font-size: 12px;
  }
  .benchmark-ring b {
    position: absolute;
    bottom: 12px;
    font-size: 14px;
    color: white;
  }
  .benchmark-ring.spark {
    background: conic-gradient(#61ba92 0 80%, #33363d 80% 100%);
  }
  .human-code {
    padding: 24px;
  }
  .human-code .terminal {
    height: 266px;
  }
  .human-code .window-bar {
    background: #ebeaee;
  }
  .human-code .window-bar i {
    opacity: 0.4;
  }
  .cheap {
    text-align: center;
    padding-top: 50px;
  }
  .cheap h3 {
    margin-bottom: 16px;
  }
  .cost-demo {
    display: flex;
    gap: 24px;
    justify-content: center;
    align-items: stretch;
    margin: 24px auto;
    max-width: 906px;
  }
  .cost-demo label {
    background: #f5f7f5;
    padding: 24px;
    text-align: left;
    flex: 1;
    font-size: 16px;
  }
  .cost-demo label output {
    display: block;
    text-align: center;
    margin: 8px;
  }
  .cost-demo input {
    display: block;
    width: 100%;
    accent-color: #777;
  }
  .cost-total {
    background: #30363a;
    color: white;
    text-align: left;
    padding: 24px;
    font-size: 16px;
    width: 240px;
  }
  .cost-total output {
    display: block;
    font:
      36px/46px Inconsolata,
      monospace;
    margin-top: 8px;
  }
  .deployment {
    padding: 80px var(--gutter);
    min-height: 718px;
  }
  .deployment > .boxed {
    margin: auto;
  }
  .deployment .tablist {
    gap: 32px;
    margin: 0 auto 16px;
  }
  .deployment .tablist button {
    font-size: 18px;
  }
  .deployment .workload-panel {
    max-width: 1116px;
    margin: auto;
    min-height: 395px;
  }
  .deployment .workload-panel > .terminal {
    min-height: 347px;
  }
  .deployment .workload-copy {
    padding-top: 40px;
  }
  .deployment .workload-logos {
    gap: 32px;
    padding-top: 48px;
  }
  .deployment .workload-logos img {
    max-width: 31%;
  }
  .testimonials {
    padding: 160px var(--gutter);
    display: grid;
    grid-template-columns: 37.5% 62.5%;
    min-height: 1826px;
    gap: 0;
  }
  .quote-intro {
    padding: 24px;
    align-self: start;
    position: sticky;
    top: 24px;
  }
  .quote-intro h2 {
    margin-bottom: 16px;
  }
  .quote-intro p {
    font-size: 24px;
    line-height: 28px;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .quote-intro small {
    font-size: 14px;
  }
  .quote-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .quote {
    background: #f5f7f5;
    margin: 0 0 10px;
    padding: 32px;
  }
  .quote-logo {
    max-width: 100%;
    height: 40px;
    margin-bottom: 24px;
  }
  .quote blockquote {
    font-size: 18px;
    line-height: 24px;
    margin: 0 0 24px;
  }
  .quote figcaption {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    font-size: 12px;
    line-height: 20px;
    gap: 8px;
  }
  .quote figcaption img {
    width: 29px;
    height: 29px;
    border-radius: 50%;
  }
  .org-band {
    text-align: center;
    min-height: 559px;
    padding: 56px var(--gutter);
    background-color: #ebeaee;
  }
  .use-cases {
    padding: 160px var(--gutter) 100px;
    min-height: 1215px;
    text-align: center;
  }
  .use-cases > .boxed {
    margin: auto;
    background: white;
    color: var(--ink);
    font-size: 46px;
    line-height: 56px;
  }
  .use-cases > p {
    font-weight: 300;
    margin: 12px 0 24px;
  }
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    text-align: left;
  }
  .case {
    display: block;
    background: #f5f7f5;
    padding: 38px;
    min-height: 368px;
  }
  .case-art {
    height: 96px;
  }
  .case h3 {
    margin-bottom: 16px;
    font-size: 20px;
    line-height: 32px;
  }
  .case small {
    font-size: 14px;
    line-height: 22px;
  }
  .tags {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    margin: 4px 0 16px;
  }
  .tags span {
    background: #262326;
    color: white;
    padding: 1px 6px;
    font-size: 12px;
    line-height: 18px;
  }
  .case p {
    font-size: 14px;
    line-height: 24px;
    margin: 4px 0 0;
  }
  .case:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--yellow);
  }
  .more-cases {
    grid-column: span 2;
    text-align: center;
    background: #ebeaee;
    padding: 70px 24px;
    align-content: center;
  }
  .more-cases h3 {
    font-size: 36px;
    line-height: 46px;
    margin-bottom: 12px;
  }
  .more-cases p {
    font-size: 16px;
    font-weight: 300;
  }
  .more-cases > div {
    display: flex;
    gap: 24px;
    align-items: center;
    justify-content: center;
  }
  .more-cases .button,
  .more-cases .text-link {
    font-size: 14px;
  }
  .home-install {
    padding: 80px var(--gutter) 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    min-height: 400px;
    overflow: hidden;
    background-color: #f5f7f5;
  }
  .home-install > div:first-child {
    padding: 24px 40px 24px 0;
  }
  .home-install h2 {
    font-size: 36px;
    line-height: 46px;
    margin-bottom: 16px;
  }
  .home-install p {
    margin-bottom: 24px;
  }
  .home-install > .terminal {
    width: calc(100% + var(--gutter));
  }
  .home-install .window-bar {
    background: #ebeaee;
  }
  .laptop-note {
    padding: 40px var(--gutter) 40px 50%;
    background: #062959;
    color: white;
    min-height: 224px;
  }
  .laptop-note p {
    max-width: 540px;
    font-weight: 600;
    font-size: 24px;
    line-height: 28px;
  }
  .laptop-note .text-link {
    font-size: 16px;
  }
  @media (max-width: 1100px) {
    .workload-copy {
      padding-right: 32px;
    }
    .workload-actions {
      gap: 16px;
    }
    .benchmark-art {
      gap: 16px;
      padding: 24px;
    }
    .benchmark-ring {
      width: 190px;
      height: 190px;
      padding: 24px;
    }
    .benchmark-ring > div {
      border-width: 16px;
    }
    .case {
      padding: 28px;
    }
  }
  @media (max-width: 991px) {
    .home-intro {
      padding-top: 56px;
      min-height: 1050px;
    }
    .home-headline {
      padding-left: 14px;
    }
    .home-headline .boxed {
      font-size: 32px;
      line-height: 40px;
      margin-left: -14px;
      padding: 6px 14px;
    }
    .home-headline p {
      font-size: 16px;
      max-width: 280px;
    }
    .home-hero {
      height: 350px;
    }
    .dashboard-art {
      margin-top: 25px;
    }
    .dashboard-window.main {
      height: 270px;
    }
    .dashboard-window.side {
      height: 240px;
      right: -20%;
    }
    .workload-tabs .section-title {
      font-size: 36px;
      line-height: 46px;
    }
    .workload-tabs .tablist {
      gap: 12px;
    }
    .workload-tabs .tablist button {
      font-size: 14px;
      padding: 16px 8px;
    }
    .workload-panel {
      grid-template-columns: 55% 45%;
    }
    .workload-copy {
