{
  "name": "dask-org",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node scripts/test.mjs",
    "format": "prettier --write src scripts astro.config.mjs package.json README.md",
    "format:check": "prettier --check src scripts astro.config.mjs package.json README.md",
    "capture": "node scripts/capture.mjs",
    "capture:states": "node scripts/compare-states.mjs",
    "test:redirects": "node scripts/redirect-checks.mjs"
  },
  "dependencies": {
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
